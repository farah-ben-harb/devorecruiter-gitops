[
  {
    "schemaId": "builtin:anomaly-detection.kubernetes.workload",
    "scope": "environment",
    "value": {
      "containerRestarts": {
        "enabled": true,
        "configuration": {
          "threshold": 3,
          "samplePeriodInMinutes": 5,
          "observationPeriodInMinutes": 10
        }
      },
      "deploymentStuck": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 10,
          "observationPeriodInMinutes": 15
        }
      },
      "pendingPods": {
        "enabled": true,
        "configuration": {
          "threshold": 1,
          "samplePeriodInMinutes": 5,
          "observationPeriodInMinutes": 10
        }
      },
      "podStuckInTerminating": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 10,
          "observationPeriodInMinutes": 15
        }
      },
      "workloadWithoutReadyPods": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 5,
          "observationPeriodInMinutes": 10
        }
      },
      "notAllPodsReady": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 5,
          "observationPeriodInMinutes": 10
        }
      },
      "highMemoryUsage": {
        "enabled": true,
        "configuration": {
          "threshold": 80,
          "samplePeriodInMinutes": 5,
          "observationPeriodInMinutes": 10
        }
      },
      "highCpuUsage": {
