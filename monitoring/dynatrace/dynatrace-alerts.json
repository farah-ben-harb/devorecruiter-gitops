        }
      },
      "podBackoffEvents": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 1,
          "observationPeriodInMinutes": 10
        }
      },
      "podEvictionEvents": {
        "enabled": true,
        "configuration": {
          "samplePeriodInMinutes": 1,
